# Server
PORT=5000
NODE_ENV=development

# Mongo (app uses MONGO_URI). Resume-fit also accepts MONGODB_URI as an alias.
MONGO_URI=mongodb://localhost:27017/placementos
MONGODB_URI=mongodb://localhost:27017/placementos

# Auth
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# AI Placement Assistant (Groq)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Resume-JD Fit Scorer — LLM extraction (optional).
# Auto-picks first available key: Groq → OpenAI → Anthropic → Gemini → offline heuristic.
# Force one provider: groq | openai | anthropic | gemini | heuristic
RESUME_FIT_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini embeddings are used for bullet ranking when GEMINI_API_KEY is set; else hashing fallback.


# Seed accounts (optional)
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
