# Server
PORT=4000

# MongoDB connection string. If unset, the API still runs and returns
# analysis results, it just won't persist ResumeFitResult documents.
MONGODB_URI=mongodb://localhost:27017/placementos

# Optional. If unset, the module falls back to a deterministic offline
# extraction/embedding implementation so it runs and passes tests with
# zero external dependencies. Set this to use real Gemini extraction
# and embeddings.
GEMINI_API_KEY=
